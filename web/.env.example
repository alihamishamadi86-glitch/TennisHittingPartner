# Server-side only; read at request time (not baked into the build).
API_INTERNAL_URL=http://localhost:8000

# Map tiles (runtime). Defaults to OpenStreetMap's tile server, which is fine for development
# but not for production traffic — use a provider (e.g. Geoapify, MapTiler) there.
# MAP_TILE_URL=https://maps.geoapify.com/v1/tile/osm-bright/{z}/{x}/{y}.png?apiKey=YOUR_KEY
# MAP_TILE_ATTRIBUTION=Powered by Geoapify | © OpenStreetMap contributors
